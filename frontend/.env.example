# Copy this file to .env and fill in real values for local dev.
# .env is gitignored -- never commit real secrets. In production
# (Vercel), this is set in the dashboard: Project -> Settings ->
# Environment Variables, not via a checked-in or uploaded .env file.

# The backend API's base URL. Local dev default (this file's fallback
# if unset, see src/api/client.ts) already points at
# http://localhost:8000, so you only need to set this for a deployed
# build -- point it at your Hugging Face Space's URL, e.g.
# https://your-username-dalgains-api.hf.space
VITE_API_URL=http://localhost:8000
