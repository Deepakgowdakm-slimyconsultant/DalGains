# Not needed in the backend image at all.
frontend/
venv/
.venv/
node_modules/
.git/
.github/

# Per-user runtime data -- HF Spaces' persistent /data volume is the
# real store in production; none of this belongs baked into the image.
data/users/
data/logs/
data/backups/
data/*.db
data/*.db-journal

# Test/dev artifacts.
tests/
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Editor/OS cruft.
.vscode/
.idea/
.DS_Store

# Secrets -- real values are set in the Space's own Settings ->
# Variables and secrets, never baked into the image.
.env
.env.*
!.env.example
