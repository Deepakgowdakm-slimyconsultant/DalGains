# Copy this file to .env and fill in real values for local dev.
# .env is gitignored -- never commit real secrets. In production
# (Render), these are set directly in the service's Environment tab,
# not via a checked-in or uploaded .env file. See src/config.py for how
# every var below is read, validated, and defaulted.

# --- Database ----------------------------------------------------------
# SQLite file path (or a full SQLAlchemy URL for another DB later).
# Default is fine for local dev -- no need to set this unless you want
# the DB somewhere other than ./data/dalgains.db.
DATABASE_URL=sqlite:///./data/dalgains.db

# --- Auth ---------------------------------------------------------------
# Signs both magic-link and session JWTs. REQUIRED in production (min 32
# characters) -- the app refuses to start without a real one when
# ENVIRONMENT=prod. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-insecure-secret-do-not-use-in-production

# Resend (resend.com) API key for sending magic-link emails. Free tier:
# no credit card, 100 emails/day / 3,000/month -- get one at
# resend.com/api-keys after creating a free account. Left unset, the
# app logs the magic link to stdout instead of emailing it (this is the
# default for every local-dev run -- nobody needs a real Resend account
# just to run the app on their laptop).
RESEND_API_KEY=

# The email that gets auto-invited (and made admin) the first time the
# app boots with this var set. Leave unset to skip auto-inviting anyone
# -- you can still invite people once someone is already an admin.
ADMIN_EMAIL=you@example.com

# --- Deployment -----------------------------------------------------------
# Where the *frontend* is deployed -- used only for where /auth/verify
# redirects the browser to after a successful login (the magic link
# itself always points at this API's own domain, not APP_URL -- see
# src/api/routes/auth.py).
APP_URL=http://localhost:5173

# dev | staging | prod. Controls the config module's fail-fast checks
# (JWT_SECRET/RESEND_API_KEY/CORS_ALLOWED_ORIGINS are required when this
# is "prod") and the session cookie's Secure/SameSite attributes.
ENVIRONMENT=dev

# Comma-separated list of origins allowed to make credentialed requests
# to this API (CORS). Must be the frontend's exact deployed origin(s) --
# browsers reject a wildcard "*" for credentialed (cookie-carrying)
# requests, so this can't just be left permissive in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
